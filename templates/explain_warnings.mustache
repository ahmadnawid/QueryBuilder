{{!
    @template report_querybuilder/explain_warnings

    Warnings list for the explain plan panel.

    Context variables:
    * has_warnings - Boolean, true if there are warnings
    * warnings_heading - Heading string for the warnings section
    * warnings - Array of warning objects with isDanger and message
    * no_warnings_message - String shown when no warnings exist

    Example context (json):
    {
        "has_warnings": true,
        "warnings_heading": "Warnings",
        "warnings": [
            {
                "isDanger": true,
                "message": "Sequential scan detected — no index used."
            },
            {
                "isDanger": false,
                "message": "Estimated rows exceed 100,000."
            }
        ],
        "no_warnings_message": "No warnings detected."
    }
}}
{{#has_warnings}}
<div class="mb-2"><strong>{{warnings_heading}}</strong></div>
<ul class="list-group">
    {{#warnings}}
    <li class="list-group-item {{#isDanger}}list-group-item-danger{{/isDanger}}{{^isDanger}}list-group-item-warning{{/isDanger}}">
        &#9888; {{message}}
    </li>
    {{/warnings}}
</ul>
{{/has_warnings}}
{{^has_warnings}}
<div class="alert alert-success">&#10004; {{no_warnings_message}}</div>
{{/has_warnings}}
